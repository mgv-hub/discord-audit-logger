{
    "name": "discord-audit-logger",
    "version": "0.4",
    "description": "Audit logging for discord.js bots — events, file persistence, optional encryption",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsx __test__/index.js",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write ."
    },
    "keywords": [
        "discord",
        "discord.js",
        "audit",
        "audit-log",
        "logger",
        "logging",
        "discord-audit-logger",
        "system-logger",
        "moderation-logger",
        "events"
    ],
    "author": "mgv-hub",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mgv-hub/discord-audit-logger.git"
    },
    "bugs": {
        "url": "https://github.com/mgv-hub/discord-audit-logger/issues"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@9.14.0",
    "devDependencies": {
        "@types/node": "^22.7.0",
        "prettier": "^3.9.8",
        "tsup": "^8.3.0",
        "typescript": "^5.6.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "tsx": "^4.22.3"
    }
}
